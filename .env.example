# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Database Configuration
# For PostgreSQL with pgvector (production/docker):
# DATABASE_URL=postgresql://finsql:finsqlpass@localhost:5432/finsqldb
# For zero-dependency local testing / fallback:
DATABASE_URL=sqlite:///./data/finsql.db

# Agent & Execution Configuration
MAX_SQL_RETRIES=3
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=1000

# Demo Mode: if true, uses deterministic financial pipeline responses when GEMINI_API_KEY is not provided
DEMO_MODE=false
